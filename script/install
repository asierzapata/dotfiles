#!/usr/bin/env bash
#
# Run all dotfiles installers.

set -e

cd "$(dirname $0)"/..

if [ "$(uname -s)" == "Darwin" ]
then
  brew bundle
fi

# find the installers and run them iteratively. agents/install.sh runs last:
# its `leaf agent setup` writes ~/.claude/settings.json, which would stop
# claude/install.sh from creating it from the template.
find . -name install.sh -not -path './agents/*' | while read installer ; do sh -c "${installer}" ; done
sh -c ./agents/install.sh
