{
  "permissions": {
    "allow": [
      "Bash(./scripts/run_test.sh:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(ls:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/asierzapata/.bun/bin/ccusage statusline",
    "padding": 0
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "figma@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "editorMode": "vim",
  "voiceEnabled": true,
  "outputStyle": "Concise",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/rex-long-running.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
